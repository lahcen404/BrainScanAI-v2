PROJECT_NAME="BrainScanAI-v2"

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB="BrainScanAI-v2"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-new-password"

# MLflow database
MLFLOW_DB_NAME="mlflow"
MLFLOW_DB_USER="mlflow"
MLFLOW_DB_PASSWORD="replace-with-a-new-password"
MLFLOW_TRACKING_URI="http://mlflow:5000"
MLFLOW_MODEL_NAME="BrainScanAI-v2"

# Airflow database
AIRFLOW_DB_USER="airflow"
AIRFLOW_DB_PASSWORD="replace-with-a-new-password"
AIRFLOW_DB_NAME="airflow"
AIRFLOW__API_AUTH__JWT_SECRET="replace-with-a-new-secret"

# Application
API_URL="http://api:8000"
MODEL_DIR="/app/models"
DATASET_DIR="/app/datasets"

# pgAdmin
PGADMIN_EMAIL="your-email@example.com"
PGADMIN_PASSWORD="replace-with-a-new-password"
